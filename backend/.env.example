# Entorno de ejecucion
NODE_ENV=development
PORT=4000

# Origen permitido para CORS (la SPA de Vite)
CLIENT_ORIGIN=http://localhost:5173

# Cadena de conexion a PostgreSQL
DATABASE_URL=postgresql://portafolio:cambia_esto@db:5432/portafolio

# Autenticacion con JWT
JWT_SECRET=cambia_esto_por_una_clave_larga_y_secreta
JWT_EXPIRES_IN=1d

# Credenciales de Cloudinary para el manejo de imagenes
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Supabase Storage para el PDF del portafolio
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=tu_service_role_key
SUPABASE_BUCKET=portafolio
